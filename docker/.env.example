# Argus 部署环境变量模板
# 复制为 .env 后修改（.env 已被 .gitignore 忽略，不会提交）
# 使用：podman compose --env-file .env up -d

# 运行环境：development（允许默认密钥） / production（缺失 JWT_SECRET 则启动失败）
ARGUS_ENV=development

# PostgreSQL
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus
POSTGRES_DB=argus

# JWT 签名密钥（生产环境务必改为强随机值，例如：openssl rand -hex 32）
JWT_SECRET=argus-dev-secret-change-in-production

# 许可证签名密钥（可选，生产环境建议设置自有密钥）
ARGUS_LICENSE_SECRET=
